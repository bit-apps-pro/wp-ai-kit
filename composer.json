{
  "name": "bitapps/wp-ai-kit",
  "description": "Shared MCP server and AI assistant infrastructure for Bit Apps WordPress plugins. Plugins contribute domain tools; the kit provides the transport, authorization, OAuth 2.1, AI engines and the bridges to WordPress-native Abilities, MCP Adapter and AI Client APIs when present.",
  "keywords": ["WordPress", "MCP", "AI", "abilities", "oauth"],
  "license": "GPL-2.0-or-later",
  "type": "library",
  "authors": [
    {
      "name": "Bit Apps",
      "homepage": "https://bitapps.pro"
    }
  ],
  "homepage": "https://github.com/bit-apps-pro/wp-ai-kit",
  "support": {
    "issues": "https://github.com/bit-apps-pro/wp-ai-kit/issues",
    "source": "https://github.com/bit-apps-pro/wp-ai-kit"
  },
  "archive": {
    "exclude": [
      ".gitattributes",
      ".gitignore",
      ".github",
      ".php-cs-fixer.php",
      ".php-cs-fixer.cache",
      "composer.lock",
      "phpunit.xml",
      "phpunit.integration.xml",
      "rector.php",
      "bin",
      "tests",
      "docs",
      "CONTRIBUTING.md",
      "frontend"
    ]
  },
  "require": {
    "php": ">=8.0",
    "ext-json": "*",
    "bitapps/wp-database": "^2.0"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "friendsofphp/php-cs-fixer": "^3.10",
    "phpcompatibility/phpcompatibility-wp": "*",
    "phpstan/phpstan": "^2.3 !=2.3.4",
        "phpunit/phpunit": "^9.6",
    "rector/rector": "^2.5",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "BitApps\\AiKit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BitApps\\AiKit\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
    "lint:fix": "php-cs-fixer fix --config=.php-cs-fixer.php",
    "compat": "phpcs -p ./src --standard=PHPCompatibilityWP --runtime-set testVersion 8.0-",
    "rector": "rector process --dry-run",
    "refactor": "rector process",
    "prefix-check": "php bin/check-prefix-safety.php src",
    "test": "phpunit --configuration phpunit.xml",
    "check": [
      "@lint",
      "@compat",
      "@prefix-check",
      "@rector",
      "@test"
    ],
    "test-integration": "phpunit --configuration phpunit.integration.xml"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.x-dev"
    }
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.0.0"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
